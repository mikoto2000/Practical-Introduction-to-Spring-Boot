{
  "name": "Practical-Introduction-to-Spring-Boot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "rspress build",
    "check": "biome check",
    "check:chapters": "node .github/scripts/check-chapters.mjs",
    "fix": "biome check --write",
    "dev": "rspress dev --host 0.0.0.0",
    "format": "prettier --write .",
    "lint": "eslint .",
    "textlint": "textlint ./docs",
    "typecheck": "tsc --noEmit",
    "preview": "rspress preview"
  },
  "dependencies": {
    "@rspress/core": "2.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@eslint/js": "^9.19.0",
    "@rspress/plugin-sitemap": "2.1.3",
    "@types/node": "^24.0.0",
    "eslint": "^9.19.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "rsbuild-plugin-google-analytics": "^1.0.5",
    "textlint": "^16.1.1",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "typescript-eslint": "^8.22.0",
    "typescript": "5.9.3",
    "rspress-plugin-plantuml": "^0.1.0",
    "rspress-plugin-rst-directives": "^0.2.0"
  },
  "type": "module",
  "overrides": {
    "textlint": {
      "glob": "^14.0.6"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
